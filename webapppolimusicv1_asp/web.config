<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuracion opcional para IIS / IIS Express.
    - Arranca la aplicacion en index.asp
    - Muestra los errores detallados de ASP clasico durante el desarrollo

    Si el hosting bloquea alguna seccion, puedes eliminar este archivo:
    la aplicacion funciona igual entrando directamente a login.asp.
-->
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.asp" />
                <add value="login.asp" />
            </files>
        </defaultDocument>

        <asp scriptErrorSentToBrowser="true" enableParentPaths="false" codePage="65001" />
    </system.webServer>
</configuration>
